<Project>
  <Import Project="../../../Directory.Build.props" />
  <PropertyGroup>
    <!-- Each Alice assembly emits Program; the API intentionally uses its own entry point. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
