<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- telemetry collector core (tools/telemetry-server), linked so the round-trip test needs no ASP.NET runtime -->
  <ItemGroup>
    <Compile Include="..\..\tools\telemetry-server\Core\*.cs" Link="TelemetryServer\%(Filename).cs" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Alice.Compiler\Alice.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Alice.Runtime\Alice.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Alice.Cli\Alice.Cli.csproj" />
  </ItemGroup>

</Project>