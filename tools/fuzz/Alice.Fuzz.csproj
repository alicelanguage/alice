<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone long-run fuzzer: not in Alice.sln and not part of `dotnet test`. The engine is shared with the CI seed
       set in tests/Alice.Tests/Fuzz (linked sources). See docs/tooling.md, "Fuzzing". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>alice-fuzz</AssemblyName>
    <RootNamespace>Alice.Fuzz</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Alice.Tests\Fuzz\Engine\*.cs" Link="Engine\%(Filename).cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- same version as tests/Alice.Tests (IL backend oracle, ADR 0033) -->
    <PackageReference Include="Microsoft.ILVerification" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Alice.Compiler\Alice.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Alice.Runtime\Alice.Runtime.csproj" />
  </ItemGroup>

</Project>
