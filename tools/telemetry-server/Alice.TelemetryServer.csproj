<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Standalone: not referenced by Alice.Cli/Compiler/Runtime and not in Alice.sln. The wire format is a linked source file. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Alice.Cli\Telemetry\TelemetryWire.cs" Link="Shared\TelemetryWire.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>
