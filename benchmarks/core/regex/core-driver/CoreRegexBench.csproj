<Project Sdk="Microsoft.NET.Sdk">
  <!-- Alice Core regex engine driver for benchmarks/core (ADR 0036): same RESULT protocol as baselines/dotnet -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>core-regex-bench</AssemblyName>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Alice.Runtime/Alice.Runtime.csproj" />
  </ItemGroup>
</Project>
