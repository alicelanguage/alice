<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET comparators for benchmarks/core: System.Text.Json and System.Text.RegularExpressions.
       Not part of Alice.sln. Workstation GC (the Alice default, ADR 0013), TieredPGO on (default). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <AssemblyName>core-baselines</AssemblyName>
    <RootNamespace>CoreBaselines</RootNamespace>
  </PropertyGroup>
</Project>
