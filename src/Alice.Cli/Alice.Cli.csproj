<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Alice.Compiler\Alice.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <!-- alice prove with the smt option only (opt-in): the native solver loads when a proof asks for it; compiling stays pure C# -->
    <PackageReference Include="Microsoft.Z3" Version="4.12.2" />
    <!-- Microsoft.Z3 4.12.2 is built for x64: on arm64 it does not load, and alice prove (smt option) reports Z3 as unavailable -->
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>alice</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../../assets/brand/alice.ico</ApplicationIcon>
    <!-- dotnet tool install -g Alice.Cli: the `alice` command, with sdk/ next to it -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>alice</ToolCommandName>
    <PackageId>Alice.Cli</PackageId>
    <Description>The Alice language CLI: build, run, test, format and publish Alice (.al) programs on .NET.</Description>
    <PackageTags>alice;compiler;cli;language</PackageTags>
    <NoWarn>$(NoWarn);CS8012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../Alice.Sdk/Alice.props;../Alice.Sdk/Alice.targets" Link="sdk/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- `alice guide [topic]` and `alice agents` print these; it lives at the repository root so it is easy to find and update per version -->
    <EmbeddedResource Include="../../guide/*.md" Exclude="../../guide/README.md" LogicalName="Alice.Guide.%(Filename).md" />
  </ItemGroup>
</Project>
