<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Alice.Compiler\Alice.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>alice</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../../assets/brand/alice.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../Alice.Sdk/Alice.props;../Alice.Sdk/Alice.targets" Link="sdk/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
