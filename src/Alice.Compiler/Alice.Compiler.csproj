<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alice.Runtime\Alice.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- wasm runtime (ADR 0034), read by AirToWasm.RuntimeText -->
    <EmbeddedResource Include="../Alice.Core.Wasm/rt.wat;../Alice.Core.Wasm/rt.al" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
