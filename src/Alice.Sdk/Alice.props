<Project>
  <!-- Alice language defaults. Import before the project body (or via Directory.Build.props). -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <TieredPGO>true</TieredPGO>
    <!-- integer overflow raises OverflowException (ADR 0013); `&+ &- &*` are the wrapping operators -->
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <!-- workstation GC by default (fast startup, low RSS); alice.toml [runtime] gc = "server" opts in to per-core heaps -->
    <ServerGarbageCollection Condition="'$(ServerGarbageCollection)' == ''">false</ServerGarbageCollection>
    <ConcurrentGarbageCollection Condition="'$(ConcurrentGarbageCollection)' == ''">true</ConcurrentGarbageCollection>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <!-- .alproj is unknown to MSBuild: compile through the C# targets (Alice lowers to C# then IL) -->
    <LanguageTargets Condition="'$(MSBuildProjectExtension)' == '.alproj'">$(MSBuildToolsPath)\Microsoft.CSharp.targets</LanguageTargets>
    <EnableDefaultCompileItems Condition="'$(MSBuildProjectExtension)' == '.alproj'">false</EnableDefaultCompileItems>
    <!-- Alice null safety (ADR 0004) is reported by the binder (AL0310, D1.12); Roslyn's CS8600-CS8625 on the
         generated C# stay warnings, an assertion as in the CLI. CS0165/CS0220 are C# errors already. -->
  </PropertyGroup>
</Project>
