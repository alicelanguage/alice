<Project>
  <!--
    Compiles *.al sources inside any SDK-style project (.alproj or .csproj).
    Two layouts:
      repo:      AliceCliProject + AliceRuntimeProject point at the source projects
      installed: AliceHome points at the folder holding alice.dll and Alice.Runtime.dll
  -->
  <PropertyGroup>
    <AliceHome Condition="'$(AliceHome)' == ''">$(MSBuildThisFileDirectory)../</AliceHome>
    <AliceCompiler Condition="'$(AliceCompiler)' == '' and '$(AliceCliProject)' != ''">$([System.IO.Path]::GetDirectoryName($(AliceCliProject)))/bin/$(Configuration)/net10.0/alice.dll</AliceCompiler>
    <AliceCompiler Condition="'$(AliceCompiler)' == ''">$(AliceHome)alice.dll</AliceCompiler>
  </PropertyGroup>

  <ItemGroup>
    <AliceSource Include="$(AliceSourceRoot)**/*.al" Exclude="$(AliceSourceRoot)bin/**;$(AliceSourceRoot)obj/**;$(AliceSourceRoot).alice/**;$(AliceSourceRoot)test/**" Condition="'$(AliceSourceRoot)' != ''" />
    <AliceSource Include="**/*.al" Exclude="bin/**;obj/**;$(DefaultItemExcludes)" Condition="'$(AliceSourceRoot)' == ''" />
    <ProjectReference Include="$(AliceRuntimeProject)" Condition="'$(AliceRuntimeProject)' != ''" />
    <Reference Include="Alice.Runtime" Condition="'$(AliceRuntimeProject)' == ''">
      <HintPath>$(AliceHome)Alice.Runtime.dll</HintPath>
    </Reference>
    <ProjectReference Include="$(AliceCliProject)" Condition="'$(AliceCliProject)' != ''"
                      ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="AliceGenerate" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences" Condition="'@(AliceSource)' != ''">
    <!-- evaluated at execution time: IntermediateOutputPath is defined by the SDK targets imported after this file -->
    <PropertyGroup>
      <AliceGenDir>$(ProjectDir)$(IntermediateOutputPath)alice/</AliceGenDir>
      <AliceGenDir Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)alice/</AliceGenDir>
    </PropertyGroup>
    <MakeDir Directories="$(AliceGenDir)" />
    <WriteLinesToFile File="$(AliceGenDir)refs.txt" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="dotnet &quot;$(AliceCompiler)&quot; gen -o &quot;$(AliceGenDir).&quot; --refs-file &quot;$(AliceGenDir)refs.txt&quot; --native-lib=$(AssemblyName)_native @(AliceSource->'&quot;%(FullPath)&quot;', ' ')" />
    <ItemGroup>
      <Compile Include="$(AliceGenDir)*.g.cs" />
      <FileWrites Include="$(AliceGenDir)*.g.cs" />
    </ItemGroup>
  </Target>

  <!-- @[Native] functions: compile the generated C with clang next to the assembly (optional; managed fallback otherwise) -->
  <Target Name="AliceNative" AfterTargets="Build" Condition="Exists('$(AliceGenDir)$(AssemblyName)_native.c')">
    <PropertyGroup>
      <AliceNativeLib Condition="'$(OS)' == 'Windows_NT'">$(AssemblyName)_native.dll</AliceNativeLib>
      <AliceNativeLib Condition="'$(OS)' != 'Windows_NT'">lib$(AssemblyName)_native.so</AliceNativeLib>
    </PropertyGroup>
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="clang -O3 -march=native -shared -o &quot;$(OutDir)$(AliceNativeLib)&quot; &quot;$(AliceGenDir)$(AssemblyName)_native.c&quot;" ContinueOnError="true" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="clang -O3 -march=native -shared -fPIC -o &quot;$(OutDir)$(AliceNativeLib)&quot; &quot;$(AliceGenDir)$(AssemblyName)_native.c&quot; -lm" ContinueOnError="true" />
  </Target>
</Project>
