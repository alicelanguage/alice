<Project>
  <!--
    Compiles *.al sources inside any SDK-style project (.alproj or .csproj).
    Two layouts:
      repo:      AliceCliProject + AliceRuntimeProject point at the source projects
      installed: AliceHome points at the folder holding alice.dll and Alice.Runtime.dll
  -->
  <PropertyGroup>
    <!-- alice.toml [package] naming: "alice" (snake_case, as written) or "dotnet" (public API in PascalCase) -->
    <AliceNaming Condition="'$(AliceNaming)' == ''">alice</AliceNaming>
    <AliceHome Condition="'$(AliceHome)' == ''">$(MSBuildThisFileDirectory)../</AliceHome>
    <AliceCompiler Condition="'$(AliceCompiler)' == '' and '$(AliceCliProject)' != ''">$([System.IO.Path]::GetDirectoryName($(AliceCliProject)))/bin/$(Configuration)/net10.0/alice.dll</AliceCompiler>
    <AliceCompiler Condition="'$(AliceCompiler)' == ''">$(AliceHome)alice.dll</AliceCompiler>
  </PropertyGroup>

  <ItemGroup>
    <AliceSource Include="$(AliceSourceRoot)**/*.al" Exclude="$(AliceSourceRoot)bin/**;$(AliceSourceRoot)obj/**;$(AliceSourceRoot).alice/**;$(AliceSourceRoot)test/**" Condition="'$(AliceSourceRoot)' != ''" />
    <AliceSource Include="**/*.al" Exclude="bin/**;obj/**;$(DefaultItemExcludes)" Condition="'$(AliceSourceRoot)' == ''" />
    <ProjectReference Include="$(AliceRuntimeProject)" Condition="'$(AliceRuntimeProject)' != ''" PrivateAssets="all" />
    <Reference Include="Alice.Runtime" Condition="'$(AliceRuntimeProject)' == ''">
      <HintPath>$(AliceHome)Alice.Runtime.dll</HintPath>
    </Reference>
    <ProjectReference Include="$(AliceCliProject)" Condition="'$(AliceCliProject)' != ''"
                      ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- [runtime] gc = "auto" (the alice.toml default): no fixed GC mode; AliceGcAuto sets it from what the compiler emitted -->
  <PropertyGroup Condition="'$(AliceGc)' == 'auto'">
    <ServerGarbageCollection></ServerGarbageCollection>
  </PropertyGroup>

  <!-- alice pack: Alice.Runtime is not on nuget.org, so a library package carries it next to its own assembly
       (tools already ship their whole publish output) -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AlicePackRuntime</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="AlicePackRuntime" DependsOnTargets="ResolveReferences" Condition="'$(PackAsTool)' != 'true'">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferencePath)" Condition="'%(Filename)' == 'Alice.Runtime'" />
    </ItemGroup>
  </Target>

  <Target Name="AlicePrepare" DependsOnTargets="ResolveReferences" Condition="'@(AliceSource)' != ''">
    <!-- evaluated at execution time: IntermediateOutputPath is defined by the SDK targets imported after this file -->
    <PropertyGroup>
      <AliceGenDir>$(ProjectDir)$(IntermediateOutputPath)alice/</AliceGenDir>
      <AliceGenDir Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)alice/</AliceGenDir>
    </PropertyGroup>
    <MakeDir Directories="$(AliceGenDir)" />
    <!-- written only when their content changes, so their timestamps tell AliceGenerate whether anything moved -->
    <WriteLinesToFile File="$(AliceGenDir)refs.txt" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- source generators (System.Text.Json, Regex, NuGet ones): alice gen's type check runs them as csc will -->
    <WriteLinesToFile File="$(AliceGenDir)analyzers.txt" Lines="@(Analyzer->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- an added or deleted .al file changes this list: its generated C# must be rewritten or removed -->
    <WriteLinesToFile File="$(AliceGenDir)sources.txt" Lines="@(AliceSource->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- incremental: alice gen runs only when a source, the references, the compiler or the project changed -->
  <Target Name="AliceGenerate" BeforeTargets="CoreCompile" DependsOnTargets="AlicePrepare" Condition="'@(AliceSource)' != ''"
          Inputs="@(AliceSource);$(AliceGenDir)refs.txt;$(AliceGenDir)analyzers.txt;$(AliceGenDir)sources.txt;$(AliceCompiler);$(MSBuildProjectFullPath)"
          Outputs="$(AliceGenDir)alice.stamp">
    <Exec Command="dotnet &quot;$(AliceCompiler)&quot; gen -o &quot;$(AliceGenDir).&quot; --refs-file &quot;$(AliceGenDir)refs.txt&quot; --analyzers-file &quot;$(AliceGenDir)analyzers.txt&quot; --native-lib=$(AssemblyName)_native --naming=$(AliceNaming) @(AliceSource->'&quot;%(FullPath)&quot;', ' ')" />
    <Touch Files="$(AliceGenDir)alice.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="AliceCompileItems" AfterTargets="AliceGenerate" BeforeTargets="CoreCompile" Condition="'@(AliceSource)' != ''">
    <ItemGroup>
      <Compile Include="$(AliceGenDir)*.g.cs" />
      <FileWrites Include="$(AliceGenDir)*.g.cs;$(AliceGenDir)alice.stamp" />
    </ItemGroup>
  </Target>

  <!-- server GC exactly when the program runs in parallel: parallel code building long-lived data is collection-bound
       on workstation GC, and server GC (DATAS) starts as fast with ~1 MB more memory -->
  <Target Name="AliceGcAuto" AfterTargets="AliceGenerate" Condition="'$(AliceGc)' == 'auto' and Exists('$(AliceGenDir)alice.gc')">
    <ReadLinesFromFile File="$(AliceGenDir)alice.gc">
      <Output TaskParameter="Lines" PropertyName="AliceGcPicked" />
    </ReadLinesFromFile>
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="System.GC.Server" Value="$([MSBuild]::ValueOrDefault('$(AliceGcPicked)', '').Equals('server'))" />
      <!-- server GC's default gen0 budget is large: committing it cost short runs 6-17 ms (polyglot merkle 93 vs 81 ms).
           16 MB removes that and keeps the win on big heaps (tree(23) build 116 ms vs 698 on workstation) -->
      <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="16777216" Condition="'$(AliceGcPicked)' == 'server'" />
    </ItemGroup>
  </Target>

  <!-- @[Native] functions: compile the generated C with clang next to the assembly (optional; managed fallback otherwise) -->
  <Target Name="AliceNative" AfterTargets="Build" Condition="Exists('$(AliceGenDir)$(AssemblyName)_native.c')">
    <PropertyGroup>
      <AliceNativeLib Condition="'$(OS)' == 'Windows_NT'">$(AssemblyName)_native.dll</AliceNativeLib>
      <AliceNativeLib Condition="'$(OS)' != 'Windows_NT'">lib$(AssemblyName)_native.so</AliceNativeLib>
    </PropertyGroup>
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="clang -O3 -march=native -shared -o &quot;$(OutDir)$(AliceNativeLib)&quot; &quot;$(AliceGenDir)$(AssemblyName)_native.c&quot;" ContinueOnError="true" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="clang -O3 -march=native -shared -fPIC -o &quot;$(OutDir)$(AliceNativeLib)&quot; &quot;$(AliceGenDir)$(AssemblyName)_native.c&quot; -lm" ContinueOnError="true" />
  </Target>
</Project>
