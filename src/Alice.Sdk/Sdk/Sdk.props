<Project>
  <!--
    Alice.Sdk from NuGet: <Project Sdk="Alice.Sdk/0.12.2"> compiles every *.al file in the project, in a .csproj
    or an .alproj, with no Alice installation. The compiler and Alice.Runtime ship in this package's tools/ folder.
  -->
  <PropertyGroup>
    <AliceHome>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/'))</AliceHome>
    <UsingAliceSdk>true</UsingAliceSdk>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(AliceHome)sdk/Alice.props" />
</Project>
