[1.004828, "o", "$ cat pipeline.al\r\n"]
[1.506887, "o", "# Parallel pipeline: map-filter-reduce fuses into one parallel loop\r\ndef main\r\n  sw = System.Diagnostics.Stopwatch.StartNew\r\n  sum = (0...10_000_000)\r\n    .map { |n| n * n }\r\n    .filter { |n| n % 3 == 0 }\r\n    .sum\r\n  puts \"sum = #{sum} in #{sw.ElapsedMilliseconds} ms\"\r\nend\r\n"]
[3.508845, "o", "$ dotnet /work/wt/demo-reel/src/Alice.Cli/bin/Release/net10.0/alice.dll explain pipeline.al\r\n"]
[4.415249, "o", "╭────────┬───────────────╮\r\n│ method │ optimizations │\r\n├────────┼───────────────┤\r\n"]
[4.4157, "o", "│ main   │ none          │\r\n╰────────┴───────────────╯\r\n"]
[7.423114, "o", "$ # Serial run\r\n"]
[7.924207, "o", "$ hyperfine -N -w 1 -r 3 'taskset -c 4,20 env ALICE_PAR=0 dotnet /work/wt/demo-reel/src/Alice.Cli/bin/Release/net10.0/alice.dll run pipeline.al'\r\n"]
